{
	"name": "@prosopo/result",
	"version": "0.1.0",
	"description": "Rust-style Result type for TypeScript and JavaScript: errors as typed values instead of exceptions",
	"keywords": [
		"result",
		"rust",
		"error-handling",
		"typescript",
		"either",
		"try-catch"
	],
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@11.27.1",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
		"build:esm": "tsc --project tsconfig.esm.json",
		"build:cjs": "tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
		"build:tsc": "tsc --noEmit",
		"clean": "rm -rf dist",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run --coverage",
		"changeset": "changeset",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@changesets/cli": "3.0.3",
		"@vitest/coverage-v8": "5.0.5",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/result.git"
	},
	"bugs": {
		"url": "https://github.com/prosopo/result/issues"
	},
	"homepage": "https://github.com/prosopo/result#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
